# Copy this file to .env.local and fill in your local credentials.
TIME_API_KEY="your-time-api-key"
WEATHER_API_KEY="your-weather-api-key"
# Wi-Fi is set on the device's setup page (QR code on the first start), not here.
# Default calendar link, used until one is saved on the setup page. Secret iCal
# address (Google: Settings > your calendar > "Secret address in iCal format").
# Keep it private: anyone with it can read the calendar.
CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/.../basic.ics"
