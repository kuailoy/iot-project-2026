# Copy this file to .env.local and fill in your local credentials.
TIME_API_KEY="your-time-api-key"
WEATHER_API_KEY="your-weather-api-key"
WIFI_SSID="your-wifi-name"
WIFI_PASSWORD="your-wifi-password"
# Secret iCal address of your calendar (Google: Settings > your calendar >
# "Secret address in iCal format"). Keep it private: anyone with it can read the calendar.
CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/.../basic.ics"
